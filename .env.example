# ════════════════════════════════════════════════════════════════
#  Sun — Master Environment Variables Template
# ════════════════════════════════════════════════════════════════
#  Single source of truth for all SECRETS across the ecosystem.
#  Non-secret config (IDs, flags, URLs, model names) lives in
#  services.json and is served via the registry.
#
#  To onboard:
#    cp .env.example .env
#    Fill in your real values.
# ════════════════════════════════════════════════════════════════


# ─── MongoDB (shared across all services) ──────────────────────
MONGO_URI="mongodb://user:password@<host>:27017/?directConnection=true&replicaSet=rs0&authSource=admin"

# ─── MinIO (S3-compatible object storage on NAS) ───────────────
MINIO_ENDPOINT="http://<host>:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""


# ── Vault (Secrets Server) ─────────────────────────────────────
# URL of the Vault service — used by all services to fetch secrets at boot.
# VAULT_SERVICE_TOKEN must match the contents of vault-service/vault.key.
VAULT_SERVICE_URL="http://<host>:5599"
VAULT_SERVICE_TOKEN=""


# ── Auth (Google SSO — portal-client) ─────────────────────────
# Used by portal-client to gate access via Google sign-in.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://portal.rod.dev/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""


# ── AI Provider API Keys ──────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
ELEVENLABS_API_KEY=""
INWORLD_BASIC=""
INWORLD_JWT_KEY=""
INWORLD_JWT_SECRET=""


# ── Google (service-specific keys) ─────────────────────────────
GOOGLE_PLACES_API_KEY=""
GOOGLE_CSE_CX=""
GOOGLE_CLOUD_API_KEY=""
GOOGLE_STICKERS_API_KEY=""


# ── Events & Entertainment ────────────────────────────────────
TICKETMASTER_API_KEY=""
SEATGEEK_CLIENT_ID=""
TMDB_API_KEY=""


# ── Finance ────────────────────────────────────────────────────
FINNHUB_API_KEY=""
FRED_API_KEY=""


# ── Product / eCommerce ────────────────────────────────────────
BESTBUY_API_KEY=""
PRODUCTHUNT_API_KEY=""
PRODUCTHUNT_API_SECRET=""
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
ETSY_API_KEY=""
ETSY_SHARED_SECRET=""


# ── Social / Trends ───────────────────────────────────────────
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
X_BEARER_TOKEN=""


# ── Weather / Space / Science ─────────────────────────────────
TOMORROWIO_API_KEY=""
NASA_API_KEY="DEMO_KEY"


# ── Web Search ─────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=""


# ── Transit ────────────────────────────────────────────────────
TRANSLINK_API_KEY=""


# ── Utility ────────────────────────────────────────────────────
IPINFO_TOKEN=""


# ── Maritime ───────────────────────────────────────────────────
AIS_STREAM_API_KEY=""


# ── Energy ─────────────────────────────────────────────────────
EIA_API_KEY=""


# ── Communication (Twilio) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""


# ── Smart Home ─────────────────────────────────────────────────
LIFX_BEARER_TOKEN=""


# ── Discord (Lupos) ───────────────────────────────────────────
VENDER_TOKEN=""
LUPOS_TOKEN=""
LUPOS_URL="http://<host>:1337"


# ── Discord (Stickers Bot) ────────────────────────────────────
STICKERS_DISCORD_TOKEN=""

# ── Google Analytics (GA4 Data API) ────────────────────────────
# Base64-encoded service account JSON key — must have Viewer access on GA4 property
GOOGLE_ANALYTICS_CREDENTIALS=""
# JSON array: [{"id":"<numericPropertyId>","label":"rod.dev","measurementId":"G-XXXXXXX"}]
GOOGLE_ANALYTICS_PROPERTIES=""


# ── Proxy (Bright Data) — Uncomment when ready ────────────────
# BRIGHTDATA_CUSTOMER_ID=
# BRIGHTDATA_ZONE_DATACENTER=datacenter
# BRIGHTDATA_ZONE_RESIDENTIAL=residential
# BRIGHTDATA_ZONE_ISP=isp
# BRIGHTDATA_PASSWORD=
