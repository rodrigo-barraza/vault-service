# ════════════════════════════════════════════════════════════════
#  Sun — Master Environment Variables Template
# ════════════════════════════════════════════════════════════════
#  Single source of truth for all secrets across the ecosystem.
#
#  To onboard:
#    cp .env.example .env
#    Fill in your real values.
# ════════════════════════════════════════════════════════════════


# ─── MongoDB (shared across all services) ──────────────────────
MONGO_URI="mongodb://user:password@<host>:27017/?directConnection=true&replicaSet=rs0&authSource=admin"

# ─── MinIO (S3-compatible object storage on NAS) ───────────────
MINIO_ENDPOINT="http://<host>:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""


# ── Service Ports ──────────────────────────────────────────────
PRISM_PORT="7777"
TOOLS_PORT="5590"
API_PORT="4001"
PORTAL_PORT="4000"
RETINA_PORT="3333"
SESSIONS_PORT="5580"
LIGHTS_PORT="4444"
LUPOS_PORT="1337"
ROD_DEV_PORT="3000"
CLOCK_CREW_PORT="3001"
STICKERS_PORT="7100"
VAULT_PORT="5599"


# ── Vault (Secrets Server) ─────────────────────────────────────
# URL of the Vault service — used by all services to fetch secrets at boot.
# VAULT_TOKEN must match the contents of vault/vault.key.
VAULT_URL="http://localhost:5599"
VAULT_TOKEN=""


# ── Service URLs (production / always-on services) ─────────────
# Only include URLs for services that are deployed and always-on.
# Services not yet deployed can be left empty.
PORTAL_URL="http://localhost:4000"
PORTAL_API_URL="http://localhost:4001"
PRISM_URL="http://localhost:7777"
TOOLS_API_URL="http://localhost:5590"
SESSIONS_URL=""
RETINA_URL="http://localhost:3333"
LIGHTS_URL="http://localhost:4444"
LUPOS_URL=""
ROD_DEV_URL=""
CLOCK_CREW_URL=""
MINIO_PUBLIC_URL=""

# ── Per-Service MongoDB Database Names ─────────────────────────
PRISM_MONGO_DB_NAME="prism"
PRISM_MINIO_BUCKET_NAME="prism"
API_MONGO_DB_NAME="portal"
SESSIONS_MONGO_DB_NAME="sessions"
STICKERS_MONGO_DB_NAME="stickers"
ROD_DEV_MINIO_BUCKET_NAME="rod-dev"


# ── LM Studio Instances ───────────────────────────────────────
LM_STUDIO_URL="http://localhost:1234"
LM_STUDIO_2_URL=""

# ── Prism Local Provider Instances ─────────────────────────────
# Each instance is defined with indexed keys: _<N>_URL, _<N>_CONCURRENCY, _<N>_NICKNAME

# LM Studio
PROVIDER_LM_STUDIO_1_URL="http://localhost:1234"
PROVIDER_LM_STUDIO_1_CONCURRENCY="1"
PROVIDER_LM_STUDIO_1_NICKNAME=""
# PROVIDER_LM_STUDIO_2_URL=
# PROVIDER_LM_STUDIO_2_CONCURRENCY=
# PROVIDER_LM_STUDIO_2_NICKNAME=

# vLLM (empty = not configured)
# PROVIDER_VLLM_1_URL=
# PROVIDER_VLLM_1_CONCURRENCY=

# Ollama
PROVIDER_OLLAMA_1_URL="http://localhost:11434"
PROVIDER_OLLAMA_1_CONCURRENCY="1"

# llama.cpp
PROVIDER_LLAMA_CPP_1_URL="http://localhost:8080"
PROVIDER_LLAMA_CPP_1_CONCURRENCY="1"


