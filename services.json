{
  "version": 1,

  "services": [
    {
      "id": "vault-service",
      "label": "Vault Service",
      "type": "infra",
      "port": 5599,
      "portEnv": "VAULT_SERVICE_PORT",
      "urlEnv": "VAULT_SERVICE_URL",
      "healthPath": "/health",
      "description": "Centralized secret store and service registry",
      "db": null,
      "repo": "vault-service",
      "dockerProject": "vault-service",
      "deployTier": 0,
      "dependsOn": []
    },
    {
      "id": "tools-service",
      "label": "Tools Service",
      "type": "service",
      "port": 5590,
      "portEnv": "TOOLS_SERVICE_PORT",
      "urlEnv": "TOOLS_SERVICE_URL",
      "healthPath": "/health",
      "description": "Tool execution hub — agentic tools, data fetchers, caches, compute",
      "db": "tools",
      "repo": "tools-service",
      "dockerProject": "tools-service",
      "deployTier": 1,
      "dependsOn": [
        { "id": "mongodb", "criticality": "required" },
        { "id": "vault-service", "criticality": "required" },
        { "id": "prism-service", "criticality": "optional" }
      ]
    },
    {
      "id": "portal-service",
      "label": "Portal Service",
      "type": "service",
      "port": 4001,
      "portEnv": "PORTAL_SERVICE_PORT",
      "urlEnv": "PORTAL_SERVICE_URL",
      "healthPath": "/health",
      "description": "Portal backend API — user data, content management",
      "db": "portal",
      "repo": "portal-service",
      "dockerProject": "portal-service",
      "deployTier": 1,
      "dependsOn": [
        { "id": "mongodb", "criticality": "required" },
        { "id": "vault-service", "criticality": "required" },
        { "id": "prism-service", "criticality": "optional" },
        { "id": "tools-service", "criticality": "optional" },
        { "id": "minio", "criticality": "optional" }
      ]
    },
    {
      "id": "lights-service",
      "label": "Lights Service",
      "type": "service",
      "port": 4444,
      "portEnv": "LIGHTS_SERVICE_PORT",
      "urlEnv": "LIGHTS_SERVICE_URL",
      "healthPath": "/health",
      "description": "Smart light control — LIFX, Philips Hue",
      "db": null,
      "repo": "lights-service",
      "dockerProject": "lights-service",
      "deployTier": 1,
      "dependsOn": [
        { "id": "vault-service", "criticality": "required" },
        { "id": "mongodb", "criticality": "required" }
      ]
    },
    {
      "id": "clock-crew-service",
      "label": "Clock Crew Service",
      "type": "service",
      "port": 5593,
      "portEnv": "CLOCK_CREW_SERVICE_PORT",
      "urlEnv": "CLOCK_CREW_SERVICE_URL",
      "healthPath": "/health",
      "description": "Clock Crew + Newgrounds community archive, scraping, asset management",
      "db": "clockcrew",
      "repo": "clock-crew-service",
      "dockerProject": "clock-crew-service",
      "deployTier": 1,
      "dependsOn": [
        { "id": "mongodb", "criticality": "required" },
        { "id": "vault-service", "criticality": "required" }
      ]
    },
    {
      "id": "messages-service",
      "label": "Messages Service",
      "type": "service",
      "port": 5601,
      "portEnv": "MESSAGES_SERVICE_PORT",
      "urlEnv": "MESSAGES_SERVICE_URL",
      "healthPath": "/health",
      "description": "Twilio messaging gateway — SMS/MMS with threading",
      "db": "messages",
      "repo": "messages-service",
      "dockerProject": "messages-service",
      "deployTier": 1,
      "dependsOn": [
        { "id": "mongodb", "criticality": "required" },
        { "id": "vault-service", "criticality": "required" }
      ]
    },
    {
      "id": "prism-service",
      "label": "Prism Gateway",
      "type": "gateway",
      "port": 7777,
      "portEnv": "PRISM_SERVICE_PORT",
      "urlEnv": "PRISM_SERVICE_URL",
      "healthPath": "/health",
      "description": "AI Gateway — multi-provider routing, agentic loop, memory, coordination",
      "db": "prism",
      "repo": "prism-service",
      "dockerProject": "prism-service",
      "deployTier": 2,
      "dependsOn": [
        { "id": "mongodb", "criticality": "required" },
        { "id": "vault-service", "criticality": "required" },
        { "id": "tools-service", "criticality": "optional" },
        { "id": "minio", "criticality": "optional" }
      ]
    },
    {
      "id": "retina-client",
      "label": "Retina Client",
      "type": "client",
      "port": 3333,
      "portEnv": "RETINA_CLIENT_PORT",
      "urlEnv": "RETINA_CLIENT_URL",
      "healthPath": "/",
      "description": "Developer playground — chat, agents, admin dashboard, benchmarks",
      "db": null,
      "repo": "retina-client",
      "dockerProject": "retina-client",
      "deployTier": 3,
      "dependsOn": [
        { "id": "prism-service", "criticality": "required" },
        { "id": "vault-service", "criticality": "optional" }
      ]
    },
    {
      "id": "portal-client",
      "label": "Portal Client",
      "type": "client",
      "port": 4000,
      "portEnv": "PORTAL_CLIENT_PORT",
      "urlEnv": "PORTAL_CLIENT_URL",
      "healthPath": "/",
      "description": "Portal frontend — public-facing website",
      "db": null,
      "repo": "portal-client",
      "dockerProject": "portal-client",
      "deployTier": 3,
      "dependsOn": [
        { "id": "portal-service", "criticality": "required" }
      ]
    },
    {
      "id": "clock-crew-client",
      "label": "Clock Crew Client",
      "type": "client",
      "port": 3001,
      "portEnv": "CLOCK_CREW_CLIENT_PORT",
      "urlEnv": "CLOCK_CREW_CLIENT_URL",
      "healthPath": "/",
      "description": "Clock Crew community portal — wiki, member profiles, Flash archive",
      "db": null,
      "repo": "clock-crew-client",
      "dockerProject": "clock-crew-client",
      "deployTier": 3,
      "dependsOn": [
        { "id": "vault-service", "criticality": "required" },
        { "id": "tools-service", "criticality": "optional" }
      ]
    },
    {
      "id": "messages-client",
      "label": "Messages Client",
      "type": "client",
      "port": 5602,
      "portEnv": "MESSAGES_CLIENT_PORT",
      "urlEnv": "MESSAGES_CLIENT_URL",
      "healthPath": "/",
      "description": "SMS dashboard — messaging, phone lookup, account management",
      "db": null,
      "repo": "messages-client",
      "dockerProject": "messages-client",
      "deployTier": 3,
      "dependsOn": [
        { "id": "messages-service", "criticality": "required" }
      ]
    },
    {
      "id": "lights-client",
      "label": "Lights Client",
      "type": "client",
      "port": 4445,
      "portEnv": "LIGHTS_CLIENT_PORT",
      "urlEnv": "LIGHTS_CLIENT_URL",
      "healthPath": "/",
      "description": "Smart lighting dashboard — controls, scenes, automation",
      "db": null,
      "repo": "lights-client",
      "dockerProject": "lights-client",
      "deployTier": 3,
      "dependsOn": [
        { "id": "lights-service", "criticality": "required" }
      ]
    },
    {
      "id": "rod-dev-client",
      "label": "Rod Dev Client",
      "type": "client",
      "port": 3000,
      "portEnv": "ROD_DEV_CLIENT_PORT",
      "urlEnv": "ROD_DEV_CLIENT_URL",
      "healthPath": "/",
      "description": "Personal portfolio / dev site",
      "db": null,
      "repo": "rod-dev-client",
      "dockerProject": "rod-dev-client",
      "deployTier": 3,
      "dependsOn": [
        { "id": "prism-service", "criticality": "required" },
        { "id": "vault-service", "criticality": "optional" }
      ]
    },
    {
      "id": "lupos-bot",
      "label": "Lupos Bot",
      "type": "bot",
      "port": 1337,
      "portEnv": "LUPOS_BOT_PORT",
      "urlEnv": "LUPOS_BOT_URL",
      "healthPath": "/health",
      "description": "Discord bot — AI chat, memory, media archival, guild management",
      "db": "lupos",
      "repo": "lupos-bot",
      "dockerProject": "lupos-bot",
      "deployTier": 3,
      "dependsOn": [
        { "id": "prism-service", "criticality": "required" },
        { "id": "mongodb", "criticality": "required" },
        { "id": "vault-service", "criticality": "optional" }
      ]
    }
  ],

  "infrastructure": [
    {
      "id": "mongodb",
      "label": "MongoDB",
      "type": "database",
      "defaultPort": 27017,
      "urlEnv": "MONGO_URI",
      "description": "Primary data store — shared across all services"
    },
    {
      "id": "minio",
      "label": "MinIO",
      "type": "object-store",
      "defaultPort": 9000,
      "urlEnv": "MINIO_ENDPOINT",
      "description": "S3-compatible object storage for media and files"
    }
  ]
}
