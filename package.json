{
  "name": "vault-service",
  "version": "1.1.0",
  "description": "Sun — Centralized Secrets Server",
  "type": "module",
  "main": "dist/server.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run",
    "generate-key": "node -e \"import('crypto').then(c => console.log(c.randomBytes(48).toString('base64url')))\""
  },
  "dependencies": {
    "@rodrigo-barraza/utilities-library": "github:rodrigo-barraza/utilities-library",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "next",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@rodrigo-barraza/utilities-library",
      "esbuild",
      "protobufjs",
      "canvas",
      "unrs-resolver",
      "sharp"
    ]
  }
}
